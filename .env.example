# TasksDAV local / compose env (copy to .env — never commit)

# Public URL (must match Google OAuth redirect)
BASE_URL=http://127.0.0.1:8080
APP_PORT=8080

# Session + Fernet key for Google refresh tokens (long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Compose Postgres (default). For Neon, replace DATABASE_URL and you can omit db service.
POSTGRES_PASSWORD=tasksdav
DATABASE_URL=postgresql+asyncpg://tasksdav:tasksdav@db:5432/tasksdav

# Neon example (prod):
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST-pooler.region.aws.neon.tech/neondb?ssl=require

# Google OAuth web client (Tasks API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_PATH=/auth/google/callback
